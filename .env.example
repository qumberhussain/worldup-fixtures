# Copy to .env.local for local dev, and set these in the Vercel dashboard for prod.

# Live data (optional). Without it the app serves clearly-labelled sample data.
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Competition code for football-data.org (defaults to WC).
# COMPETITION=WC

# Canonical site origin — drives canonical URLs, OG tags, sitemap & robots.
# No trailing slash. Defaults to https://worldup-fixtures.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=https://worldup-fixtures.vercel.app

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). GA only loads when set.
# Create a property at https://analytics.google.com and link Google Search Console.
NEXT_PUBLIC_GA_ID=

# Vercel Web Analytics & Speed Insights need no env vars — just enable them in
# the Vercel project dashboard (Analytics tab). The components are always mounted.
